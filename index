0}.trip-type.active{background:#fff;color:var(--navy)}.search-panel{margin-top:12px;background:#fff;color:var(--text);padding:11px;border-radius:18px;box-shadow:0 20px 40px #001d3340}.search-grid{display:grid;grid-template-columns:1.1fr 1.1fr .9fr .9fr .7fr auto;gap:8px}.field{background:#f4f8fb;border-radius:12px;padding:8px 11px}.field label{display:block;color:#8797a8;font-size:9px;text-transform:uppercase;font-weight:900}.field input,.field select{border:0;background:transparent;width:100%;font-weight:800;color:var(--text);outline:0;padding:4px 0}.traveller-row{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:8px}.source-row{display:flex;align-items:center;flex-wrap:wrap;gap:9px;margin-top:9px;padding:9px;background:#f6f9fc;border-radius:12px}.source-check{display:flex;align-items:center;gap:5px;font-size:11px;font-weight:700}.primary{border:0;border-radius:12px;padding:12px 20px;background:linear-gradient(135deg,var(--cyan),var(--blue));color:#fff;font-weight:900}.multi-list{display:grid;gap:8px}.multi-row{display:grid;grid-template-columns:1fr 1fr .8fr auto;gap:8px}.add-leg{width:100%;border:1px dashed #93b8d6;background:#eef8ff;color:#08669e;border-radius:11px;padding:10px;font-weight:900;margin-top:8px}.remove{border:0;border-radius:10px;background:#fff0f2;color:var(--red);font-weight:900}.section-head{display:flex;justify-content:space-between;align-items:end;gap:12px;margin:25px 0 11px}.section-head h2{margin:0;font-size:22px}.section-head p,.muted{margin:2px 0 0;color:var(--muted);font-size:12px}.sort,.secondary{border:1px solid var(--line);background:#fff;padding:9px 12px;border-radius:10px;font-weight:700}.content-grid{display:grid;grid-template-columns:1.45fr .72fr;gap:20px}.cards{display:grid;gap:11px}.empty{padding:35px;text-align:center;background:#fff;border:1px dashed #aec5d9;border-radius:18px;color:var(--muted)}.empty strong{display:block;color:var(--text);font-size:17px}.flight,.panel,.side-card,.hotel{border:1px solid var(--line);background:#fff;border-radius:18px;padding:16px;box-shadow:0 5px 16px #2846640a}.flight.selected,.hotel.selected{border:2px solid var(--blue)}.flight-top,.hotel-top{display:flex;justify-content:space-between;gap:12px}.flight-main{display:flex;gap:12px;align-items:center}.rank{width:43px;height:43px;border-radius:12px;background:#eaf6ff;color:var(--blue);display:grid;place-items:center;font-weight:900}.route{font-weight:900;font-size:16px}.chip{display:inline-block;padding:4px 8px;border-radius:99px;font-size:10px;font-weight:900;background:#e8f6ff;color:#076aae}.price{text-align:right;font-size:18px;font-weight:900}.flight-meta{margin-top:13px;display:grid;grid-template-columns:repeat(5,1fr);gap:7px;background:#f6f9fc;border-radius:11px;padding:10px}.flight-meta span{font-size:10px;color:var(--muted)}.flight-meta b{display:block;font-size:12px}.check-item{display:flex;gap:10px;margin-top:10px;padding:11px;background:#f7f9fc;border-radius:11px}.check-icon{width:28px;height:28px;border-radius:8px;background:#e9f6ff;color:var(--blue);display:grid;place-items:center;font-weight:900}.warning{margin-top:12px;background:#fff5db;color:#8a5a00;padding:11px;border-radius:11px;font-size:11px}.pdf-btn{width:100%;border:0;border-radius:15px;background:var(--navy);color:#fff;font-weight:900;padding:15px;margin-top:12px}.pdf-btn:disabled{opacity:.45}.hotels{display:grid;grid-template-columns:repeat(4,1fr);gap:11px}.hotel h4{margin:8px 0}.hotel-price{color:var(--blue);font-size:17px;font-weight:900;margin-top:10px}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.metric{color:#fff;padding:19px;border-radius:20px;box-shadow:var(--shadow)}.metric:nth-child(1){background:linear-gradient(135deg,#087ce8,#22b9e3)}.metric:nth-child(2){background:linear-gradient(135deg,#7048e8,#9d67ed)}.metric:nth-child(3){background:linear-gradient(135deg,#0ca878,#35d39d)}.metric:nth-child(4){background:linear-gradient(135deg,#ee8d1a,#f8ba38)}.metric label{display:block;font-size:11px;margin-top:9px}.metric strong{font-size:23px}.dash-grid{display:grid;grid-template-columns:1.45fr .75fr;gap:16px;margin-top:16px}.chart{height:265px;display:flex;align-items:end;gap:9px;padding-top:32px}.bar-wrap{height:100%;flex:1;display:flex;flex-direction:column;justify-content:end;align-items:center;gap:7px}.bar{width:100%;background:linear-gradient(180deg,#31d2ec,var(--blue));border-radius:8px 8px 2px 2px;min-height:8px}.bar-wrap small{font-size:9px;color:var(--muted)}.donut-wrap{display:grid;place-items:center;padding:22px}.donut{width:180px;height:180px;border-radius:50%;background:conic-gradient(#0877e6 0 30%,#7048e8 30% 52%,#12bddd 52% 70%,#10a879 70% 84%,#ee9b14 84% 94%,#cbd5e1 94%);display:grid;place-items:center}.donut:after{content:"Destinations";width:100px;height:100px;border-radius:50%;background:#fff;display:grid;place-items:center;font-weight:900}.table-box{overflow:auto;margin-top:16px}.data-table{width:100%;border-collapse:collapse;min-width:1120px}.data-table th,.data-table td{text-align:left;padding:11px 12px;border-bottom:1px solid var(--line);font-size:11px}.data-table th{background:#f7f9fc}.data-table input{width:105px;border:1px solid var(--line);border-radius:7px;padding:7px}.profit{font-weight:900;color:var(--green)}.danger-btn{border:0;background:#fff0f2;color:var(--red);border-radius:8px;padding:7px 9px}.toolbar{display:flex;gap:8px}.settings-wrap{max-width:900px;margin:auto}.form-row{margin-top:15px}.form-row label{font-weight:900}.key-input{display:grid;grid-template-columns:170px 1fr 1fr;border:1px solid var(--line);background:#f7f9fc;border-radius:11px;overflow:hidden}.key-input input,.key-input select{border:0;background:transparent;padding:12px;outline:0}.save{width:100%;margin-top:18px;background:var(--navy);color:#fff;border:0;border-radius:12px;padding:13px;font-weight:900}.info{background:#eaf6ff;border:1px solid #b9def4;border-radius:15px;padding:16px;margin-top:15px}.loading{height:180px;display:grid;place-items:center;background:#fff;border-radius:18px}.spinner{width:28px;height:28px;border:3px solid #cee7fa;border-top-color:var(--blue);border-radius:50%;animation:spin .7s linear infinite;margin:auto}@keyframes spin{to{transform:rotate(360deg)}}.error{background:#fff0f2;color:#a6293d;border:1px solid #ffc7d0;padding:12px;border-radius:12px;margin-top:10px}.toast{position:fixed;right:20px;bottom:20px;background:#0d3c2f;color:#fff;padding:12px 16px;border-radius:12px;z-index:60}@media(max-width:960px){.search-grid{grid-template-columns:1fr 1fr}.content-grid,.dash-grid{grid-template-columns:1fr}.hotels,.metrics{grid-template-columns:repeat(2,1fr)}}@media(max-width:620px){.shell{padding:12px 12px 90px}.contact{display:none}.hero{padding:22px 15px}.hero h1{font-size:27px}.search-grid,.traveller-row,.multi-row{grid-template-columns:1fr}.flight-top{display:block}.price{text-align:left}.flight-meta{grid-template-columns:repeat(2,1fr)}.hotels,.metrics{grid-template-columns:1fr}.tabs{position:fixed;z-index:50;bottom:0;left:0;right:0;margin:0}.key-input{grid-template-columns:1fr}}
</style><script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script></head><body>
<header class="topbar"><div class="top-inner"><div class="brand"><div class="logo">✈</div><div>Travel <span style="color:var(--blue)">Express</span><small>LOVE TO MAKE YOUR JOURNEY PLEASANT</small></div></div><div class="contact"><b>+880 1729 911908</b><br>Uttara East, Dhaka-1230 · info@travelexpress.net.bd</div></div></header>
<main class="shell"><nav class="tabs"><button type="button" class="tab active" data-page="search">🔎 Smart Search</button><button type="button" class="tab" data-page="dashboard">📊 Analytics</button><button type="button" class="tab" data-page="settings">⚙ API Setup</button></nav>
<section id="searchPage" class="page"><div class="hero"><span class="eyebrow">✦ COMMITMENT · QUICK RESPONSE · ATTRACTIVE PRICE</span><h1>Live flights, destination hotels and smarter customer proposals.</h1><p>Search domestic and global routes, compare authorized providers and prepare a polished downloadable travel proposal.</p><div class="trip-types"><button type="button" class="trip-type active" data-trip="oneway">One way</button><button type="button" class="trip-type" data-trip="round">Round trip</button><button type="button" class="trip-type" data-trip="multi">Multi-city</button></div><div class="search-panel"><div id="standardSearch" class="search-grid"><div class="field"><label>From</label><input id="from" list="airports" placeholder="Dhaka, Bangladesh (DAC)"></div><div class="field"><label>To</label><input id="to" list="airports" placeholder="Bangkok, Thailand (BKK)"></div><div class="field"><label>Departure</label><input id="depart" type="date"></div><div class="field"><label>Return</label><input id="returnDate" type="date" disabled></div><div class="field"><label>Cabin</label><select id="cabin"><option value="ECONOMY">Economy</option><option value="BUSINESS">Business</option><option value="FIRST">First</option></select></div><button type="button" class="primary search-trigger">Search live</button></div><div id="multiSearch" class="hidden"><div id="multiList" class="multi-list"></div><button type="button" class="add-leg" id="addLeg">+ Add another city</button><button type="button" class="primary search-trigger" style="width:100%;margin-top:8px">Search live</button></div><div class="traveller-row"><div class="field"><label>Adults, age 12+</label><input id="adults" type="number" min="1" max="9" value="1"></div><div class="field"><label>Children, age 2-11</label><input id="children" type="number" min="0" max="8" value="0"></div><div class="field"><label>Infants, under 2</label><input id="infants" type="number" min="0" max="4" value="0"></div></div><div class="source-row"><b>Show results from:</b><label class="source-check"><input type="checkbox" name="flightSource" value="sharetrip" checked>ShareTrip</label><label class="source-check"><input type="checkbox" name="flightSource" value="google" checked>Google Flights partner</label><label class="source-check"><input type="checkbox" name="flightSource" value="flightexpert" checked>Flight Expert</label><label class="source-check"><input type="checkbox" name="flightSource" value="custom" checked>API setup provider</label></div></div></div><datalist id="airports"></datalist><div id="searchError" class="error hidden"></div><div class="content-grid"><div><div class="section-head"><div><h2>Live flight options</h2><p>Ranked by price, duration, stops and baggage.</p></div><select class="sort" id="sortFlights"><option value="recommended">Recommended</option><option value="price">Lowest price</option><option value="duration">Shortest duration</option></select></div><div id="flightResults" class="cards"><div class="empty"><strong>Connect an authorized flight provider</strong>Configure a secure backend endpoint in API Setup. No sample fares are displayed.</div></div></div><aside><div class="section-head"><div><h2>Traveller requirements</h2></div></div><div class="side-card" id="checklist"><div class="empty"><strong>No itinerary selected</strong>Requirements appear after a live result is selected.</div></div><button type="button" class="pdf-btn" id="pdfBtn" disabled>⬇ Download smart-search PDF</button></aside></div><div class="section-head"><div><h2>Live destination hotels</h2></div><select class="sort" id="hotelSource"><option value="all">All connected providers</option><option value="booking">Booking.com</option><option value="agoda">Agoda</option><option value="custom">API setup provider</option></select></div><div id="hotelResults" class="hotels"><div class="empty"><strong>No live hotel results yet</strong>Hotels load after a successful search.</div></div></section>
<section id="dashboardPage" class="page hidden"><div class="section-head"><div><span class="eyebrow" style="background:#eef0ff;color:#6849c8">TRAVEL EXPRESS INTELLIGENCE</span><h2>Business performance cockpit</h2></div><div class="toolbar"><button type="button" id="addSale" class="secondary">+ Add product</button><button type="button" id="exportSales" class="secondary">Export CSV</button></div></div><div class="metrics" id="metrics"></div><div class="dash-grid"><div class="panel"><h3>Monthly revenue</h3><div class="chart" id="salesChart"></div></div><div class="panel"><h3>Destination mix</h3><div class="donut-wrap"><div class="donut"></div></div><div class="muted" id="destinationLegend"></div></div></div><div class="panel table-box"><h3>Sales performance</h3><p class="muted">Net profit = revenue − tax − VAT − airline payment − AIT − discounts.</p><table class="data-table"><thead><tr><th>Product</th><th>Customers</th><th>Revenue</th><th>Tax %</th><th>Tax amount</th><th>VAT %</th><th>VAT amount</th><th>Airline payment</th><th>AIT</th><th>Discounts</th><th>Net profit</th><th></th></tr></thead><tbody id="salesBody"></tbody></table></div></section>
<section id="settingsPage" class="page hidden"><div class="settings-wrap"><div class="section-head"><div><span class="eyebrow" style="background:#fff3d9;color:#916000">SECURE LIVE CONNECTIONS</span><h2>API and aggregator setup</h2><p>Use Travel Express backend proxy endpoints, not provider secrets in this file.</p></div></div><div class="panel"><h3>Provider connections</h3><div id="apiFields"></div><button type="button" class="save" id="saveApi">Save connection settings</button></div><div class="panel" style="margin-top:15px"><h3>Manual Test Data</h3><p class="muted">Upload the Travel Express test workbook to load flights, hotels, traveller requirements and dashboard sales without changing the live API setup.</p><div class="key-input" style="grid-template-columns:1fr auto;margin-top:12px"><input id="manualExcel" type="file" accept=".xlsx,.xls"><button type="button" class="secondary" id="loadManual">Load test workbook</button></div><div id="manualStatus" class="info hidden" style="margin-top:10px"></div></div><div class="info"><b>Security requirement:</b> Production credentials must stay on a secure backend.</div></div></section></main><div id="toast" class="toast hidden"></div>
<script>
const airports=[['Dhaka','Bangladesh','DAC'],['Chattogram','Bangladesh','CGP'],['Cox’s Bazar','Bangladesh','CXB'],['Sylhet','Bangladesh','ZYL'],['Saidpur','Bangladesh','SPD'],['Jashore','Bangladesh','JSR'],['Bangkok','Thailand','BKK'],['Phuket','Thailand','HKT'],['Kuala Lumpur','Malaysia','KUL'],['Singapore','Singapore','SIN'],['Dubai','United Arab Emirates','DXB'],['Abu Dhabi','United Arab Emirates','AUH'],['Doha','Qatar','DOH'],['Jeddah','Saudi Arabia','JED'],['Istanbul','Türkiye','IST'],['London','United Kingdom','LHR'],['Paris','France','CDG'],['Frankfurt','Germany','FRA'],['New York','United States','JFK'],['Toronto','Canada','YYZ'],['Sydney','Australia','SYD'],['Auckland','New Zealand','AKL'],['Delhi','India','DEL'],['Kolkata','India','CCU'],['Mumbai','India','BOM'],['Kathmandu','Nepal','KTM'],['Colombo','Sri Lanka','CMB'],['Malé','Maldives','MLE'],['Jakarta','Indonesia','CGK'],['Bali','Indonesia','DPS'],['Hong Kong','Hong Kong','HKG'],['Tokyo','Japan','NRT'],['Seoul','South Korea','ICN']];
let tripType='oneway',multiLegs=2,flights=[],hotels=[],selectedFlight=null,selectedHotel=null,sales=[];
const $=id=>document.getElementById(id),money=n=>new Intl.NumberFormat('en-BD',{style:'currency',currency:'BDT',maximumFractionDigits:0}).format(Number(n)||0),esc=s=>String(s??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
function toast(m){$('toast').textContent=m;$('toast').classList.remove('hidden');setTimeout(()=>$('toast').classList.add('hidden'),2800)}function showError(m){$('searchError').textContent=m;$('searchError').classList.remove('hidden')}function clearError(){$('searchError').classList.add('hidden')}function extractCode(v){const m=String(v).toUpperCase().match(/\(([A-Z]{3})\)|\b([A-Z]{3})$/);return m?(m[1]||m[2]):String(v).trim().toUpperCase()}
function init(){ $('airports').innerHTML=airports.map(a=>`<option value="${a[0]}, ${a[1]} (${a[2]})">`).join('');let d=new Date();d.setDate(d.getDate()+1);$('depart').value=d.toISOString().slice(0,10);d.setDate(d.getDate()+5);$('returnDate').value=d.toISOString().slice(0,10);renderApi();loadSales();setTrip('oneway') }
function setTrip(t){tripType=t;document.querySelectorAll('.trip-type').forEach(b=>b.classList.toggle('active',b.dataset.trip===t));$('standardSearch').classList.toggle('hidden',t==='multi');$('multiSearch').classList.toggle('hidden',t!=='multi');$('returnDate').disabled=t!=='round';if(t==='multi')renderMulti()}
function renderMulti(){ $('multiList').innerHTML=Array.from({length:multiLegs},(_,i)=>`<div class="multi-row"><div class="field"><label>From ${i+1}</label><input class="mfrom" list="airports"></div><div class="field"><label>To ${i+1}</label><input class="mto" list="airports"></div><div class="field"><label>Date</label><input class="mdate" type="date"></div>${i>1?`<button type="button" class="remove" data-remove="${i}">Remove</button>`:'<span></span>'}</div>`).join('');document.querySelectorAll('[data-remove]').forEach(b=>b.onclick=()=>{multiLegs--;renderMulti()}) }
function config(){try{return JSON.parse(localStorage.getItem('travel_express_api')||'{}')}catch{return {}}}
function validate(){let segments=tripType==='multi'?[...document.querySelectorAll('.multi-row')].map(r=>({from:extractCode(r.querySelector('.mfrom').value),to:extractCode(r.querySelector('.mto').value),date:r.querySelector('.mdate').value})):[{from:extractCode($('from').value),to:extractCode($('to').value),date:$('depart').value}];if(tripType==='round')segments.push({from:segments[0].to,to:segments[0].from,date:$('returnDate').value});if(segments.some(s=>!s.from||!s.to||!s.date))throw Error('Complete all route and date fields.');const adults=+$('adults').value,children=+$('children').value,infants=+$('infants').value;if(adults<1)throw Error('At least one adult is required.');if(infants>adults)throw Error('Infants cannot exceed adults.');const sources=[...document.querySelectorAll('[name=flightSource]:checked')].map(x=>x.value);if(!sources.length)throw Error('Select at least one flight source.');return{segments,travellers:{adults,children,infants},sources}}
async function post(url,body,token){const c=new AbortController(),timer=setTimeout(()=>c.abort(),30000);try{const r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json',...(token?{Authorization:'Bearer '+token}:{})},body:JSON.stringify(body),signal:c.signal});if(!r.ok)throw Error('Provider returned HTTP '+r.status);return await r.json()}finally{clearTimeout(timer)}}
function nf(x,i){return{id:x.id||'f'+i,provider:x.provider||x.source||'Provider',route:x.route||`${x.origin||''} → ${x.destination||''}`,airline:x.airline||'',depart:x.departure||x.depart||'',arrive:x.arrival||x.arrive||'',duration:+(x.durationHours||x.duration||0),durationText:x.durationText||'',stops:+(x.stops||0),price:+(x.totalPrice||x.price||0),currency:x.currency||'BDT',score:+(x.score||0),baggage:x.baggage||x.baggageAllowance||'Confirm with airline',wait:x.layover||x.wait||'Not supplied',visa:x.visa||'Verify officially',transit:x.transitVisa||x.transit||'Verify officially',lounge:x.lounge||'Check access',taxi:x.transport||x.taxi||'Check destination transport'}}
function nh(x,i){return{id:x.id||'h'+i,name:x.name||'Property',provider:x.provider||x.source||'Provider',area:x.area||x.address||'',rating:+(x.rating||0),price:+(x.totalPrice||x.price||0),currency:x.currency||'BDT',distance:x.distance||'',amenity:Array.isArray(x.amenities)?x.amenities.join(' · '):(x.amenities||'')}}
async function searchLive(){clearError();let q;try{q=validate()}catch(e){showError(e.message);return}const c=config();if(!c.flight?.endpoint){showError('No live flight endpoint is configured. Open API Setup and save a secure backend endpoint.');return}$('flightResults').innerHTML='<div class="loading"><div><div class="spinner"></div>Requesting live fares…</div></div>';try{const d=await post(c.flight.endpoint,{tripType,segments:q.segments,travellers:q.travellers,cabin:$('cabin').value,sources:q.sources},c.flight.token);flights=(d.flights||d.results||[]).map(nf);if(!flights.length)throw Error('No flights returned.');selectedFlight=flights[0].id;renderFlights();renderChecklist();$('pdfBtn').disabled=false;await searchHotels(q,c)}catch(e){flights=[];$('flightResults').innerHTML='<div class="empty"><strong>Live search unsuccessful</strong>No sample fares are shown.</div>';showError(e.name==='AbortError'?'Provider timed out after 30 seconds.':e.message)}}
async function searchHotels(q,c){if(!c.hotel?.endpoint){$('hotelResults').innerHTML='<div class="empty"><strong>Hotel API not connected</strong>Configure a hotel endpoint.</div>';return}try{const s=q.segments,d=await post(c.hotel.endpoint,{destination:s[s.length-1].to,checkIn:s[0].date,checkOut:tripType==='round'?s[1].date:'',guests:q.travellers,source:$('hotelSource').value},c.hotel.token);hotels=(d.hotels||d.results||[]).map(nh);renderHotels()}catch(e){$('hotelResults').innerHTML=`<div class="empty"><strong>Hotel search unsuccessful</strong>${esc(e.message)}</div>`}}
function renderFlights(){const sort=$('sortFlights').value,data=[...flights].sort((a,b)=>sort==='price'?a.price-b.price:sort==='duration'?a.duration-b.duration:(b.score-a.score||a.price-b.price));$('flightResults').innerHTML=data.slice(0,5).map((f,i)=>`<article class="flight ${String(selectedFlight)===String(f.id)?'selected':''}" data-flight="${esc(f.id)}"><div class="flight-top"><div class="flight-main"><div class="rank">${i+1}</div><div><div class="route">${esc(f.route)} <span class="chip">${esc(f.provider)}</span></div><div class="muted">${esc(f.airline)} · ${esc(f.depart)} → ${esc(f.arrive)}</div></div></div><div class="price">${f.currency==='BDT'?money(f.price):esc(f.currency)+' '+f.price}</div></div><div class="flight-meta"><div><span>Duration</span><b>${esc(f.durationText||f.duration+'h')}</b></div><div><span>Stops</span><b>${f.stops}</b></div><div><span>Connection</span><b>${esc(f.wait)}</b></div><div><span>Baggage</span><b>${esc(f.baggage)}</b></div><div><span>Score</span><b>${f.score||'N/A'}</b></div></div></article>`).join('');document.querySelectorAll('[data-flight]').forEach(x=>x.onclick=()=>{selectedFlight=x.dataset.flight;renderFlights();renderChecklist()})}
function renderChecklist(){const f=flights.find(x=>String(x.id)===String(selectedFlight));if(!f)return;const a=[['V','Visa',f.visa],['T','Transit visa',f.transit],['W','Waiting time',f.wait],['B','Baggage',f.baggage],['L','Lounge',f.lounge],['C','Transport',f.taxi]];$('checklist').innerHTML='<h3>Traveller requirements</h3>'+a.map(i=>`<div class="check-item"><div class="check-icon">${i[0]}</div><div><b>${i[1]}</b><div class="muted">${esc(i[2])}</div></div></div>`).join('')+'<div class="warning">Verify all conditions with official sources before ticketing.</div>'}
function renderHotels(){$('hotelResults').innerHTML=hotels.length?hotels.slice(0,8).map(h=>`<article class="hotel ${String(selectedHotel)===String(h.id)?'selected':''}" data-hotel="${esc(h.id)}"><div class="hotel-top"><span class="chip">${esc(h.provider)}</span><b>★ ${h.rating||'N/A'}</b></div><h4>${esc(h.name)}</h4><div class="muted">${esc(h.area)} · ${esc(h.distance)}</div><div class="muted">${esc(h.amenity)}</div><div class="hotel-price">${h.currency==='BDT'?money(h.price):esc(h.currency)+' '+h.price}</div></article>`).join(''):'<div class="empty"><strong>No properties returned</strong></div>';document.querySelectorAll('[data-hotel]').forEach(x=>x.onclick=()=>{selectedHotel=x.dataset.hotel;renderHotels()})}
function downloadPDF(){const f=flights.find(x=>String(x.id)===String(selectedFlight)),h=hotels.find(x=>String(x.id)===String(selectedHotel))||hotels[0];if(!f){toast('Select a live flight first.');return}const w=window.open('','_blank');if(!w){toast('Allow pop-ups to generate the PDF.');return}w.document.write(`<!doctype html><title>Travel Express Proposal</title><style>body{font-family:Arial;color:#15263b;padding:35px}.head{border-bottom:4px solid #0877e6}.box{border:1px solid #ddd;border-radius:14px;padding:18px;margin:14px 0}.row{display:flex;justify-content:space-between}.price{font-size:22px;color:#0877e6;font-weight:bold}.notice{background:#fff5db;padding:10px}@media print{button{display:none}}</style><div class="head"><h1>Travel Express</h1><p>Love to make your Journey Pleasant</p></div><h2>Smart Search Proposal</h2><div class="box"><div class="row"><div><h2>${esc(f.route)}</h2>${esc(f.airline)} · ${esc(f.provider)}</div><div class="price">${f.currency==='BDT'?money(f.price):esc(f.currency)+' '+f.price}</div></div><p>${esc(f.depart)} → ${esc(f.arrive)} · ${esc(f.durationText)} · ${f.stops} stop(s)</p><p>Baggage: ${esc(f.baggage)}</p></div>${h?`<div class="box"><h2>${esc(h.name)}</h2><p>${esc(h.area)} · ★ ${h.rating}</p><div class="price">${h.currency==='BDT'?money(h.price):esc(h.currency)+' '+h.price}</div></div>`:''}<div class="box"><h2>Requirements</h2><ul><li>${esc(f.visa)}</li><li>${esc(f.transit)}</li><li>${esc(f.wait)}</li><li>${esc(f.lounge)}</li><li>${esc(f.taxi)}</li></ul></div><p class="notice">Live prices may change until booking. Verify visa, transit and baggage conditions.</p><button onclick="print()">Save as PDF</button>`);w.document.close();setTimeout(()=>w.print(),300)}
const apiDefs=[['flight','Flight aggregation endpoint'],['hotel','Hotel aggregation endpoint'],['requirements','Travel requirements endpoint'],['ai','AI ranking endpoint']];function renderApi(){const c=config();$('apiFields').innerHTML=apiDefs.map(a=>`<div class="form-row"><label>${a[1]}</label><div class="key-input"><select id="provider_${a[0]}"><option>Custom API</option><option>ShareTrip</option><option>Google Flights Partner</option><option>Flight Expert</option><option>Booking.com</option><option>Agoda</option></select><input id="endpoint_${a[0]}" value="${esc(c[a[0]]?.endpoint||'')}" placeholder="Secure backend endpoint"><input id="token_${a[0]}" type="password" value="${esc(c[a[0]]?.token||'')}" placeholder="Backend token"></div></div>`).join('')}function saveApi(){const c={};apiDefs.forEach(a=>c[a[0]]={provider:$('provider_'+a[0]).value,endpoint:$('endpoint_'+a[0]).value.trim(),token:$('token_'+a[0]).value.trim()});localStorage.setItem('travel_express_api',JSON.stringify(c));toast('Connection settings saved.')}
function loadSales(){try{sales=JSON.parse(localStorage.getItem('travel_express_sales')||'[]')}catch{sales=[]}renderSales()}function addSale(){sales.push({name:'',customers:0,revenue:0,tax:0,vat:0,airline:0,ait:0,discount:0,month:new Date().getMonth()});saveSales()}function saveSales(){localStorage.setItem('travel_express_sales',JSON.stringify(sales));renderSales()}function calc(r){const tax=r.revenue*r.tax/100,vat=r.revenue*r.vat/100;return{tax,vat,profit:r.revenue-tax-vat-r.airline-r.ait-r.discount}}
function renderSales(){$('salesBody').innerHTML=sales.length?sales.map((r,i)=>{const c=calc(r);return`<tr><td><input data-i="${i}" data-k="name" value="${esc(r.name)}"></td>${['customers','revenue','tax'].map(k=>`<td><input type="number" data-i="${i}" data-k="${k}" value="${r[k]}"></td>`).join('')}<td>${money(c.tax)}</td><td><input type="number" data-i="${i}" data-k="vat" value="${r.vat}"></td><td>${money(c.vat)}</td>${['airline','ait','discount'].map(k=>`<td><input type="number" data-i="${i}" data-k="${k}" value="${r[k]}"></td>`).join('')}<td class="profit">${money(c.profit)}</td><td><button type="button" class="danger-btn" data-delete="${i}">Delete</button></td></tr>`}).join(''):'<tr><td colspan="12">No sales records. Click Add product.</td></tr>';document.querySelectorAll('#salesBody input').forEach(x=>x.onchange=()=>{sales[x.dataset.i][x.dataset.k]=x.dataset.k==='name'?x.value:+x.value;saveSales()});document.querySelectorAll('[data-delete]').forEach(x=>x.onclick=()=>{sales.splice(+x.dataset.delete,1);saveSales()});renderDashboard()}
function renderDashboard(){const t=sales.reduce((a,r)=>{const c=calc(r);a.revenue+=r.revenue;a.customers+=r.customers;a.tax+=c.tax;a.profit+=c.profit;return a},{revenue:0,customers:0,tax:0,profit:0});$('metrics').innerHTML=[['৳','Revenue',money(t.revenue)],['◎','Net profit',money(t.profit)],['👥','Customers',t.customers],['▣','Tax',money(t.tax)]].map(m=>`<div class="metric"><b>${m[0]}</b><label>${m[1]}</label><strong>${m[2]}</strong></div>`).join('');const monthly=Array(12).fill(0);sales.forEach(r=>monthly[r.month||0]+=r.revenue);const max=Math.max(...monthly,1),names=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];$('salesChart').innerHTML=monthly.map((v,i)=>`<div class="bar-wrap"><div class="bar" style="height:${v/max*90}%"></div><small>${names[i]}</small></div>`).join('');$('destinationLegend').textContent=sales.length?'Connect booking records to populate destinations.':'No booking data.'}
function exportSales(){const h=['Product','Customers','Revenue','Tax %','Tax amount','VAT %','VAT amount','Airline payment','AIT','Discounts','Net profit'];const rows=sales.map(r=>{const c=calc(r);return[r.name,r.customers,r.revenue,r.tax,c.tax,r.vat,c.vat,r.airline,r.ait,r.discount,c.profit]});const csv=[h,...rows].map(r=>r.map(v=>'"'+String(v).replaceAll('"','""')+'"').join(',')).join('\n');const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv'}));a.download='travel-express-sales.csv';a.click()}

let manualRequirements=[];
function sheetRows(workbook,name){const sh=workbook.Sheets[name];return sh?XLSX.utils.sheet_to_json(sh,{defval:''}):[]}
function valueOf(row,names){for(const n of names){if(Object.prototype.hasOwnProperty.call(row,n))return row[n]}return ''}
function applyManualRequirements(){flights=flights.map(f=>{const code=(f.route.match(/→\s*([A-Z]{3})/)||[])[1]||'';const r=manualRequirements.find(x=>String(valueOf(x,['destination','Destination'])).toUpperCase()===code);return r?{...f,visa:valueOf(r,['visa','Visa'])||f.visa,transit:valueOf(r,['transitVisa','Transit Visa'])||f.transit,baggage:valueOf(r,['baggage','Baggage'])||f.baggage,lounge:valueOf(r,['lounge','Lounge'])||f.lounge,taxi:valueOf(r,['transport','Transport'])||f.taxi}:f})}
async function loadManualWorkbook(){const file=$('manualExcel').files[0];if(!file){toast('Choose the Excel workbook first.');return}if(typeof XLSX==='undefined'){showManualStatus('Excel reader could not load. Connect to the internet once and reload the page.',true);return}try{const data=await file.arrayBuffer(),wb=XLSX.read(data,{type:'array'});const fr=sheetRows(wb,'Flights'),hr=sheetRows(wb,'Hotels'),rr=sheetRows(wb,'Requirements'),sr=sheetRows(wb,'Sales');if(!fr.length||!hr.length)throw Error('The workbook must contain Flights and Hotels sheets.');flights=fr.map(nf);hotels=hr.map(nh);manualRequirements=rr;applyManualRequirements();selectedFlight=flights[0]?.id||null;selectedHotel=hotels[0]?.id||null;renderFlights();renderChecklist();renderHotels();$('pdfBtn').disabled=!flights.length;sales=sr.map(r=>({name:valueOf(r,['Product name','name']),customers:+valueOf(r,['Customers','customers']),revenue:+valueOf(r,['Revenue','revenue']),tax:+valueOf(r,['Tax %','tax']),vat:+valueOf(r,['VAT %','vat']),airline:+valueOf(r,['Airline payment','airline']),ait:+valueOf(r,['AIT','ait']),discount:+valueOf(r,['Discounts','discount']),month:+valueOf(r,['Month','month']),destination:valueOf(r,['Destination','destination'])}));saveSales();showManualStatus(`Loaded ${flights.length} flights, ${hotels.length} hotels, ${rr.length} requirement records and ${sales.length} sales records.`,false);document.querySelector('[data-page="search"]').click()}catch(e){console.error(e);showManualStatus(e.message||'Unable to read the test workbook.',true)}}
function showManualStatus(message,isError){const x=$('manualStatus');x.textContent=message;x.classList.remove('hidden');x.style.background=isError?'#fff0f2':'#e8faf3';x.style.color=isError?'#a6293d':'#087a58';x.style.borderColor=isError?'#ffc7d0':'#b9ead8'}

function bind(){document.querySelectorAll('.tab').forEach(t=>t.onclick=()=>{document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));document.querySelectorAll('.page').forEach(x=>x.classList.add('hidden'));t.classList.add('active');$(t.dataset.page+'Page').classList.remove('hidden')});document.querySelectorAll('.trip-type').forEach(b=>b.onclick=()=>setTrip(b.dataset.trip));document.querySelectorAll('.search-trigger').forEach(b=>b.onclick=()=>searchLive());$('addLeg').onclick=()=>{if(multiLegs<6){multiLegs++;renderMulti()}else toast('Maximum six segments.')};$('sortFlights').onchange=()=>{if(flights.length)renderFlights()};$('hotelSource').onchange=()=>{if(flights.length)searchLive();else toast('Run a flight search first.')};$('pdfBtn').onclick=downloadPDF;$('saveApi').onclick=saveApi;$('loadManual').onclick=loadManualWorkbook;$('addSale').onclick=addSale;$('exportSales').onclick=exportSales}
document.addEventListener('DOMContentLoaded',()=>{init();bind()});
</script></body></html>
